# =========================
# Bot
# =========================
BOT_TOKEN=

POLL_INTERVAL=3
SYNDICATE_DEBUG=1

# =========================
# Storage
# =========================
USE_MONGO=1

MONGO_URI=mongodb://localhost:27017/
MONGO_DB=waste_syndicate

SYNDICATE_SAVE=waste_syndicate_save.json
SYNDICATE_TEXTS_DIR=./texts

# Ephemeral state only (chat_states, short-lived caches) — safe to
# lose; never used for player progress. USE_REDIS=0 falls back to an
# in-memory store for local dev without a Redis server.
USE_REDIS=1
REDIS_URL=redis://localhost:6379/0

# =========================
# Game
# =========================
SEASON_LENGTH_DAYS=21
DAILY_EVENT_HOUR=7

# =========================
# Admin
# =========================
ADMIN_IDS=

# مثال:
# ADMIN_IDS=u012345,u098765

# =========================
# Group
# =========================
GAME_GROUP_ID=

GROUP_RADIO_ENABLED=1
GROUP_RADIO_MIN_INTERVAL=7200
GROUP_BOSS_REPORT_INTERVAL=1800